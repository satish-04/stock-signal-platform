# Stock Signal App - Core Configuration
# Copy this to .env and fill in your values

# Trading Configuration
TRADING_MODE=paper  # paper, live
MARKET_DATA_MODE=mock  # mock, real
ENABLE_ORDER_SUBMISSION=false  # Safety switch for order submission
ENABLE_LIVE_TRADING=false  # Kill switch for live trading

# IBKR Configuration
IBKR_HOST=localhost
IBKR_PORT=7496  # 7497 for TWS, 7496 for IB Gateway
IBKR_CLIENT_ID=1

# Claude AI Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODE=mock  # mock, claude
AI_MODEL=claude-3-5-sonnet

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/stock_signal_app
DATABASE_POOL_SIZE=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# TradingView Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_PORT=8000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
